# =============================================================================
# Haemophilia Data Ingestion System — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./haemophilia_data.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/haemophilia_db

# --- Logging ---
LOG_LEVEL=INFO

# --- Data retention ---
DATA_RETENTION_DAYS=365

# --- Enabled ingestors ---
INGESTORS_ENABLED=clinical_trials,pubmed,openfda,who_ictrp,medrxiv,arxiv,patents,sec_edgar

# --- Run intervals (in minutes) ---
INGESTOR_CLINICAL_TRIALS_INTERVAL_MINUTES=1440
INGESTOR_PUBMED_INTERVAL_MINUTES=1440
INGESTOR_OPENFDA_INTERVAL_MINUTES=1440
INGESTOR_WHO_ICTRP_INTERVAL_MINUTES=10080
INGESTOR_MEDRXIV_INTERVAL_MINUTES=1440
INGESTOR_ARXIV_INTERVAL_MINUTES=1440
INGESTOR_PATENTS_INTERVAL_MINUTES=10080
INGESTOR_SEC_EDGAR_INTERVAL_MINUTES=10080

# --- Global rate limiting ---
API_RATE_LIMIT_DELAY_MS=333

# --- Retry settings ---
ERROR_RETRY_MAX_ATTEMPTS=3
ERROR_RETRY_BASE_DELAY_SECONDS=2

# --- API Keys (optional) ---
NCBI_API_KEY=
OPENFDA_API_KEY=
USPTO_API_KEY=

# --- SEC EDGAR ---
SEC_EDGAR_USER_AGENT=haemophilia-ingestor admin@example.com

# --- Batch limits ---
INGESTOR_MAX_ITEMS_PER_RUN=5000
