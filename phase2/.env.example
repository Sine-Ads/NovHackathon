# --- HuggingFace Inference ---
HF_TOKEN=
PHASE2_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# alternate: meta-llama/Llama-3.3-70B-Instruct

# --- Local embeddings (fastembed / ONNX Runtime) ---
PHASE2_EMBED_MODEL=BAAI/bge-small-en-v1.5
PHASE2_EMBED_DIM=384

# --- Paths (blank = auto-resolve from the phase2 package location) ---
PHASE2_SOURCE_DB=
PHASE2_SIDECAR_DB=

# --- Retrieval / chat tuning ---
MIN_EVIDENCE=0.008
THIN_CONTENT_CHARS=50
MAX_HISTORY_TURNS=6

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000
PHASE2_EMBED_CACHE=
